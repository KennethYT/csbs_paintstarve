{
  "name": "csbs-paintstarve",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "//build": "OpenNext 內部會呼叫這個 build script 來產生 Next.js 產物，所以這裡必須是 next build，不能是 opennextjs-cloudflare build（會無限遞迴）",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.6.25",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "kysely": "^0.29.4",
    "next": "^16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.116.0"
  }
}