{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "csp-paintstarve",
  "main": ".open-next/worker.js",

  // nodejs_compat 是 @opennextjs/cloudflare 的硬性要求，
  // compatibility_date 也必須 >= 2024-09-23 才會啟用完整的 Node.js API。
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }

  // 機密（DATABASE_URL、BETTER_AUTH_SECRET、DISCORD_*）不寫在這裡。
  // 正式環境用 `wrangler secret put <NAME>` 或 Cloudflare 後台設定；
  // 本機 `pnpm preview` 讀的是 .dev.vars（已在 .gitignore 內）。
}
