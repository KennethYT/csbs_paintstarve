# ---- 資料庫 ----------------------------------------------------------------
# Postgres 連線字串。Neon / Supabase / Vercel Postgres / 本機 Docker 都可以。
DATABASE_URL="postgresql://user:password@localhost:5432/paintstarve?schema=public"

# ---- better-auth -----------------------------------------------------------
# 用來簽章 session 的密鑰，正式環境請換成隨機值：openssl rand -base64 32
BETTER_AUTH_SECRET="請換成隨機的長字串"
# 這個站台對外的網址，OAuth 回呼會用到
BETTER_AUTH_URL="http://localhost:3000"

# ---- Discord 身份組驗證登入（必填）-----------------------------------------
# Discord 是唯一的登入方式，這一整段不設定的話就沒有人能登入。
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# 機器人 token，用來查詢使用者在伺服器內的身份組
DISCORD_BOT_TOKEN=""
# 要驗證的伺服器 ID
DISCORD_GUILD_ID=""
# 對應教師／學生的身份組 ID，可用逗號分隔多個
DISCORD_TEACHER_ROLE_ID=""
DISCORD_STUDENT_ROLE_ID=""
